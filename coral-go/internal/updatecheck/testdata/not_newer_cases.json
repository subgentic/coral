{
  "comment": "One table for both NotNewer functions (updatecheck.NotNewer, which the server uses, and verify.NotNewer, which the updater uses): they must agree on every row. staged is a plain X.Y.Z, as a staged release always is; installed may carry a v, a prerelease or build suffix, or not be a version at all (nothing is dropped on a guess).",
  "cases": [
    {"staged": "2.0.1", "installed": "2.0.3", "notNewer": true,  "why": "lower (the live case)"},
    {"staged": "2.0.3", "installed": "2.0.3", "notNewer": true,  "why": "equal"},
    {"staged": "2.0.4", "installed": "2.0.3", "notNewer": false, "why": "higher"},
    {"staged": "2.0.3", "installed": "2.0.3-rc1", "notNewer": false, "why": "a release is newer than a prerelease of itself"},
    {"staged": "2.0.3", "installed": "2.0.4-rc1", "notNewer": true,  "why": "lower than a later prerelease"},
    {"staged": "2.0.4", "installed": "2.0.4-rc1", "notNewer": false, "why": "the release over its prerelease"},
    {"staged": "2.0.3", "installed": "v2.0.3", "notNewer": true,  "why": "a v on the installed one"},
    {"staged": "2.0.1", "installed": "v2.0.3-rc2", "notNewer": true, "why": "a v and a prerelease"},
    {"staged": "2.0.3", "installed": "2.0.3+build5", "notNewer": false, "why": "build metadata is not a version Coral uses: nothing is dropped on a guess"},
    {"staged": "2.0.1", "installed": "dev", "notNewer": false, "why": "an unknown version says nothing"},
    {"staged": "2.0.1", "installed": "", "notNewer": false, "why": "no version says nothing"},
    {"staged": "nonsense", "installed": "2.0.3", "notNewer": false, "why": "a staged version that is not a version says nothing"},
    {"staged": "2.0.4-rc1", "installed": "2.0.4", "notNewer": true, "why": "a prerelease is older than its release"},
    {"staged": "v2.0.4", "installed": "2.0.4", "notNewer": true, "why": "a v on the staged one"},
    {"staged": "2.0.4-rc2", "installed": "2.0.4-rc1", "notNewer": false, "why": "a later prerelease"},
    {"staged": "2.0.4-rc1", "installed": "2.0.4-rc2", "notNewer": true, "why": "an earlier prerelease"},
    {"staged": "10.0.0", "installed": "9.9.9", "notNewer": false, "why": "numbers, not text"},
    {"staged": "9.9.9", "installed": "10.0.0", "notNewer": true, "why": "numbers, not text"}
  ]
}
