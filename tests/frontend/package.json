{
  "name": "coral-frontend-tests",
  "version": "1.0.0",
  "private": true,
  "description": "End-to-end tests for Coral frontend JS via headless Chrome + CDP",
  "scripts": {
    "test": "node acf_model_field.test.js",
    "test:cloud": "node run_cloud_checks.mjs",
    "test:cdp": "node run_cdp_suites.mjs",
    "test:cdp:stress": "node run_cdp_suites.mjs --stress",
    "test:cdp:cloud": "node run_cdp_suites.mjs --only cloud_csp_browser,fetch_metadata_browser",
    "lint:undef": "cd ../../coral-go/pkg/frontend && node ../../../tests/frontend/node_modules/eslint/bin/eslint.js -c ../../../tests/frontend/eslint.config.mjs --no-warn-ignored static",
    "test:runner-folder-loss": "node run_runner_folder_loss.mjs",
    "check:dock-parity": "node dock_parity.mjs"
  },
  "dependencies": {
    "chrome-remote-interface": "^0.33.0"
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "eslint": "9.39.5",
    "globals": "17.13.0"
  }
}
