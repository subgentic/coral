<?xml version="1.0" encoding="UTF-8"?>

<!--
  WiX v4 installer definition for Coral.
  Builds an MSI that:
    - Installs coral.exe to Program Files\Coral
    - Adds Coral to the system PATH
    - Creates a Start Menu shortcut
    - Registers for clean uninstall

  ProductName is the name shown in the installer and in Apps & features: "Coral". The Coral For Dropbox
  tier ships no MSI (.github/workflows/release.yml skips every MSI step for it). Manufacturer is the
  publisher, Subgentic LLC; the UpgradeCode is unchanged so upgrades keep working.
-->

<?ifndef ProductName ?>
<?define ProductName = "Coral" ?>
<?endif ?>
<!-- The install folder's name under Program Files: the folder, and where the close-for-install action looks for a running Coral (#335). -->
<?ifndef InstallFolderName ?>
<?define InstallFolderName = "Coral" ?>
<?endif ?>

<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package
    Name="$(var.ProductName)"
    Manufacturer="Subgentic LLC"
    Version="$(var.Version)"
    UpgradeCode="B8F2E3A1-7C4D-4E5F-9A1B-2C3D4E5F6A7B">

    <MajorUpgrade
      DowngradeErrorMessage="A newer version of $(var.ProductName) is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <!-- Install to Program Files\Coral -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="$(var.InstallFolderName)">
        <Component Id="CoralExe" Guid="A1B2C3D4-E5F6-7890-ABCD-EF1234567890">
          <File Id="coral.exe" Source="$(var.BinDir)\coral.exe" KeyPath="yes" />

          <!-- Add to PATH -->
          <Environment
            Id="PATH"
            Name="PATH"
            Value="[INSTALLFOLDER]"
            Permanent="no"
            Part="last"
            Action="set"
            System="yes" />
        </Component>

        <Component Id="LaunchCoralExe" Guid="C3D4E5F6-A7B8-9012-CDEF-234567890123">
          <File Id="launch_coral.exe" Source="$(var.BinDir)\launch-coral.exe" KeyPath="yes" />
        </Component>

        <Component Id="CoralBoardExe" Guid="D4E5F6A7-B8C9-0123-DEFA-345678901234">
          <File Id="coral_board.exe" Source="$(var.BinDir)\coral-board.exe" KeyPath="yes" />
        </Component>

        <Component Id="CoralTrayExe" Guid="E5F6A7B8-C9D0-1234-EFAB-456789012345">
          <File Id="coral_tray.exe" Source="$(var.BinDir)\coral-tray.exe" KeyPath="yes" />
        </Component>

        <Component Id="CoralAppExe" Guid="F6A7B8C9-D0E1-2345-FABC-567890123456">
          <File Id="coral_app.exe" Source="$(var.BinDir)\coral-app.exe" KeyPath="yes" />
        </Component>

        <Component Id="HookAgenticState" Guid="A7B8C9D0-E1F2-3456-ABCD-678901234567">
          <File Id="coral_hook_agentic_state.exe" Source="$(var.BinDir)\coral-hook-agentic-state.exe" KeyPath="yes" />
        </Component>

        <Component Id="HookTaskSync" Guid="B8C9D0E1-F2A3-4567-BCDE-789012345678">
          <File Id="coral_hook_task_sync.exe" Source="$(var.BinDir)\coral-hook-task-sync.exe" KeyPath="yes" />
        </Component>

        <Component Id="HookMessageCheck" Guid="C9D0E1F2-A3B4-5678-CDEF-890123456789">
          <File Id="coral_hook_message_check.exe" Source="$(var.BinDir)\coral-hook-message-check.exe" KeyPath="yes" />
        </Component>

        <Component Id="HookSessionStart" Guid="D0E1F2A3-B4C5-6789-DEFA-901234567890">
          <File Id="coral_hook_session_start.exe" Source="$(var.BinDir)\coral-hook-session-start.exe" KeyPath="yes" />
        </Component>

        <Component Id="CoralUpdate" Guid="C26B2BA3-7EA8-404D-AF56-32A41AADF614">
          <File Id="coral_update.exe" Source="$(var.BinDir)\coral-update.exe" KeyPath="yes" />
        </Component>

        <Component Id="CoralAgentExe" Guid="E1F2A3B4-C5D6-7890-EFAB-012345678901">
          <File Id="coral_agent.exe" Source="$(var.BinDir)\coral-agent.exe" KeyPath="yes" />
        </Component>

        <!-- Third-party notices (installers/third-party-notices.sh): installed as Coral\licenses -->
        <Directory Id="LicensesFolder" Name="licenses" />
      </Directory>
    </StandardDirectory>

    <!-- Start Menu shortcut -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="CoralMenuFolder" Name="Coral">
        <Component Id="CoralShortcut" Guid="B2C3D4E5-F6A7-8901-BCDE-F12345678901">
          <Shortcut
            Id="CoralStartMenuShortcut"
            Name="$(var.ProductName)"
            Target="[INSTALLFOLDER]coral-tray.exe"
            Arguments="--backend pty"
            WorkingDirectory="INSTALLFOLDER"
            Description="$(var.ProductName) — AI Agent Dashboard"
            Icon="CoralIcon.exe" />

          <RemoveFolder Id="RemoveCoralMenuFolder" On="uninstall" />
          <RegistryValue
            Root="HKCU"
            Key="Software\Coral"
            Name="installed"
            Type="integer"
            Value="1"
            KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <!-- Icon for the Start Menu shortcut and the Apps & features entry: the multi-size icon
         resource embedded in coral-tray.exe (tools/gen_windows_resources.sh) -->
    <Icon Id="CoralIcon.exe" SourceFile="$(var.BinDir)\coral-tray.exe" />
    <Property Id="ARPPRODUCTICON" Value="CoralIcon.exe" />

    <!-- Apps & features: the project's public pages (README) -->
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/subgentic/coral" />
    <Property Id="ARPHELPLINK" Value="https://subgentic.github.io/coral/" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/subgentic/coral/releases/latest" />

    <!-- License agreement dialog. license.rtf is the app's own terms text (pinned to it by
         TestInstallerTermsMatchEULAText), so it is shown as it is. -->
    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.BuildDir)\license.rtf" />

    <!-- The last screen offers to start Coral, ticked (#151): coral-tray.exe, as the Start Menu shortcut does, however the person ran
         the installer (#205: by double-click or from an elevated prompt). It runs from the Finish button, in the installer's client (UI)
         process, as an immediate action, never as a deferred or no-impersonate one (those would run it as SYSTEM or elevated).
         ExitDialog shows the checkbox only on a first install or an upgrade (NOT Installed), and the launch has the same condition plus
         NOT REMOVE~="ALL", so a repair or an uninstall starts nothing. A silent or basic-UI install (/qn, /passive, the update's /qb!-)
         shows no ExitDialog and starts nothing.
         Both actions are SYNCHRONOUS (Return="ignore"): in the client, Windows Installer fails an asynchronous EXE custom action
         (asyncNoWait or asyncWait) with 1631 and never creates the process, elevated client or not (#199, measured on Windows 11).
         What they start returns at once (coral-tray's launcher once its background process is started, explorer.exe once it has
         handed the program on), so Finish waits only a moment, and the exit code is not checked.
         They are Directory-based, so coral-tray starts in its install folder, not in the folder the installer was run from (often
         Downloads). Exactly one runs, by MsiRunningElevated, which the installer sets in an elevated client and not in a normal one:
         - LaunchCoral, a normal client: coral-tray with the from-installer flag, as the person who ran the installer.
         - LaunchCoralUnelevated, an ELEVATED client (msiexec run as administrator, whose token would start Coral with its server,
           agents and tools as an administrator): explorer.exe, by its full path, is handed coral-tray.exe and passes it to its
           Elevated-Unelevated Explorer Factory ({75dff2b7-6936-4c06-a8bb-676a7b00b24b}), a COM server whose AppID runs as the
           Interactive User. Coral starts with the signed-in desktop user's own token, Medium integrity, unelevated (#194, #199).
           explorer.exe passes no arguments, and coral-tray needs none. With no Explorer shell (Shell Launcher, Assigned Access)
           nothing starts, and the person starts Coral from the Start Menu.
         The backstop stays: coral-tray.exe started with the from-installer flag and an elevated token starts nothing
         (cmd/coral-tray/installer_launch.go, #5883), so a LaunchCoral that ever ran elevated would not start Coral as an administrator. -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch $(var.ProductName)" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <CustomAction Id="LaunchCoral" Directory="INSTALLFOLDER" ExeCommand="&quot;[INSTALLFOLDER]coral-tray.exe&quot; --from-installer" Execute="immediate" Return="ignore" />
    <CustomAction Id="LaunchCoralUnelevated" Directory="INSTALLFOLDER" ExeCommand="&quot;[WindowsFolder]explorer.exe&quot; &quot;[INSTALLFOLDER]coral-tray.exe&quot;" Execute="immediate" Return="ignore" />
    <!-- Task #380: just before an elevated installer's Finish hands coral-tray to Explorer, the helper writes a short-lived launch-pending
         mark in this user's %LOCALAPPDATA%\Coral (installrestart.MarkLaunchPending, the restart mark's private-file rules). A coral-tray
         that starts elevated while the mark is fresh was not started the way the installer meant, and starts nothing; every start of
         Coral takes the mark. So the unelevated start rests on Coral, not only on Explorer. Synchronous, so it is written before
         Explorer runs (Order). -->
    <CustomAction Id="MarkLaunchPending" BinaryRef="CoralMsiHelper" ExeCommand="launch-pending --product &quot;$(var.InstallFolderName)&quot;" Execute="immediate" Return="ignore" />
    <UI>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchCoral"
        Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed AND NOT REMOVE~=&quot;ALL&quot; AND NOT MsiRunningElevated" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="MarkLaunchPending" Order="1"
        Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed AND NOT REMOVE~=&quot;ALL&quot; AND MsiRunningElevated" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchCoralUnelevated" Order="2"
        Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed AND NOT REMOVE~=&quot;ALL&quot; AND MsiRunningElevated" />
    </UI>

    <!-- Coral's dialog art in place of WiX's stock bitmaps (tools/make_installer_art.py) -->
    <WixVariable Id="WixUIBannerBmp" Value="$(sys.SOURCEFILEDIR)..\assets\installer\WixUIBannerBmp.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="$(sys.SOURCEFILEDIR)..\assets\installer\WixUIDialogBmp.bmp" />

    <!-- Record the terms accepted on the license page, so coral-app skips its own prompt: coral-msi-helper eula (below), as the person
         installing; never with an elevated token (msiexec run as administrator), when the Coral window asks instead. It was a cmd.exe line,
         which opened a console window at every first install (#345). -->
    <CustomAction Id="WriteEULAMarker" BinaryRef="CoralMsiHelper"
      ExeCommand="eula --product &quot;$(var.InstallFolderName)&quot;"
      Execute="immediate" Return="ignore" />
    <!-- Closing Coral for the install, and starting it again after (#335). Coral's processes keep its programs open (the tray and its server
         child, the Coral window, an agent's coral-board or hook), and the tray and its server have no window of their own, so Restart Manager
         can't ask them to close and Windows Installer said "unable to automatically close all requested applications" and went on with the
         files in use. Before the installer looks for files in use, coral-msi-helper (built into BuildDir, carried in the Binary table, never
         installed) closes the installing person's Coral the normal way (agents marked to wake) and waits for it to end
         (cmd/coral-msi-helper). Both standard Program Files folders are given, so an x86 install (up to 1.4.156) is closed too; they are set
         from the start, unlike INSTALLFOLDER. The actions are impersonated, so they run as the person installing, never as SYSTEM (measured
         not elevated); the helper touches only that person's processes whose program is in those folders, and never ends a server or an
         agent. Its exit code is ignored: Coral not closing leaves the installer's own files-in-use handling, as before.
         Coral closes only after the person has allowed the install (UAC): a declined prompt leaves Coral running. Only the execute sequence
         runs after consent, so there is no close in the UI sequence.
           - An install or an upgrade asks for consent when the execute sequence starts, in every UI level: CloseCoralForInstall runs before
             costing, so before InstallValidate's files-in-use check, and Restart Manager finds nothing to close.
           - An uninstall (REMOVE=ALL: msiexec /x, Settings > Apps) asks only at InstallInitialize, which Windows Installer always runs after
             InstallValidate: CloseCoralForUninstall is deferred (after InstallInitialize, before any file is removed), so on a UI that
             shows it Restart Manager's "close these applications" box can come first, and Coral closes there only if the person chooses to.
         CORALCLOSED (Secure) skips the helper, to rehearse Restart Manager alone. Neither runs in the old package's uninstall inside an
         upgrade (UPGRADINGPRODUCTCODE): that one comes after the new package closed Coral and finds nothing running (#335 rehearsal, step c);
         the helper never removes the mark that starts Coral again. A plain uninstall's close (the helper's uninstall flag) never marks, and removes
         a mark the tray wrote when Restart Manager closed it for that uninstall (#345): nothing is started after an uninstall.
         After the install, when the helper closed a running Coral, it starts Coral again through explorer.exe, which hands it to Windows'
         unelevated Explorer factory: Coral then runs as the signed-in person with their own environment, not the installer's (#336). With the
         full UI the Finish page's "Launch Coral" does it instead (UILevel 5), so it is never started twice; never after an uninstall. It
         starts the product Windows Installer registered, never a folder given to it (INSTALLFOLDER is a public property). -->
    <Binary Id="CoralMsiHelper" SourceFile="$(var.BuildDir)\coral-msi-helper.exe" />
    <Property Id="CORALCLOSED" Secure="yes" />
    <CustomAction Id="CloseCoralForInstall" BinaryRef="CoralMsiHelper"
      ExeCommand="stop --product &quot;$(var.InstallFolderName)&quot; --folder &quot;[ProgramFiles64Folder]$(var.InstallFolderName)&quot; --folder &quot;[ProgramFilesFolder]$(var.InstallFolderName)&quot; --wait 60"
      Execute="immediate" Return="ignore" />
    <CustomAction Id="CloseCoralForUninstall" BinaryRef="CoralMsiHelper"
      ExeCommand="stop --uninstall --product &quot;$(var.InstallFolderName)&quot; --folder &quot;[ProgramFiles64Folder]$(var.InstallFolderName)&quot; --folder &quot;[ProgramFilesFolder]$(var.InstallFolderName)&quot; --wait 60"
      Execute="deferred" Impersonate="yes" Return="ignore" />
    <CustomAction Id="StartCoralAfterInstall" BinaryRef="CoralMsiHelper"
      ExeCommand="start --product &quot;$(var.InstallFolderName)&quot;"
      Execute="immediate" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="WriteEULAMarker" After="InstallFiles" Condition="NOT Installed" />
      <Custom Action="CloseCoralForInstall" Before="CostInitialize" Condition="NOT CORALCLOSED AND NOT UPGRADINGPRODUCTCODE AND NOT REMOVE~=&quot;ALL&quot;" />
      <Custom Action="CloseCoralForUninstall" After="InstallInitialize" Condition="NOT CORALCLOSED AND NOT UPGRADINGPRODUCTCODE AND REMOVE~=&quot;ALL&quot;" />
      <Custom Action="StartCoralAfterInstall" After="InstallFinalize" Condition="NOT REMOVE~=&quot;ALL&quot; AND UILevel &lt;&gt; 5" />
    </InstallExecuteSequence>

    <Feature Id="MainFeature" Title="$(var.ProductName)" Level="1">
      <ComponentRef Id="CoralExe" />
      <ComponentRef Id="LaunchCoralExe" />
      <ComponentRef Id="CoralBoardExe" />
      <ComponentRef Id="CoralTrayExe" />
      <ComponentRef Id="CoralAppExe" />
      <ComponentRef Id="HookAgenticState" />
      <ComponentRef Id="HookTaskSync" />
      <ComponentRef Id="HookMessageCheck" />
      <ComponentRef Id="HookSessionStart" />
      <ComponentRef Id="CoralUpdate" />
      <ComponentRef Id="CoralAgentExe" />
      <ComponentRef Id="CoralShortcut" />
      <!-- every file under bin\licenses, its folders kept (WiX v5 harvesting) -->
      <Files Directory="LicensesFolder" Include="$(var.BinDir)\licenses\**" />
    </Feature>

  </Package>

</Wix>
