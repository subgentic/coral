package slug

import "testing"

func TestSlug(t *testing.T) {
	cases := map[string]string{
		"Hello, World!": "hello-world",
		"  Café au lait ": "café-au-lait",
		"":              "",
	}
	for in, want := range cases {
		if got := Slug(in); got != want {
			t.Errorf("Slug(%q) = %q, want %q", in, got, want)
		}
	}
}
